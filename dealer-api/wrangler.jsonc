{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "theexactmatch-dealer-api",
	"main": "src/index.js",
	"compatibility_date": "2026-06-02",
	"observability": {
		"enabled": true
	},
	"vars": {
		"DEALER_WELCOME_EMAIL_ENABLED": "true",
		"CRM_HOOK_URL": "https://crm.theexactmatch.com"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "dealer-portal",
			"database_id": "de115c9b-2be3-44b0-a359-d9fb9402b667"
		}
	],
	"routes": [
		{ "pattern": "theexactmatch.com/reports/*", "zone_name": "theexactmatch.com" },
		// Narrowed from a blanket theexactmatch.com/sell/* on 2026-08-27: that
		// claimed the entire /sell/ prefix, which blocked the site worker from
		// ever serving a public /sell/ hub or /sell/[brand] page. dealer-api only
		// actually needs these four token-gated subpaths (see the matchPath calls
		// in src/index.js) — everything else under /sell/ is public site content.
		{ "pattern": "theexactmatch.com/sell/upload/*", "zone_name": "theexactmatch.com" },
		{ "pattern": "theexactmatch.com/sell/report/*", "zone_name": "theexactmatch.com" },
		{ "pattern": "theexactmatch.com/sell/photos/*", "zone_name": "theexactmatch.com" },
		{ "pattern": "theexactmatch.com/sell/quick-photos/*", "zone_name": "theexactmatch.com" },
		{ "pattern": "theexactmatch.com/submissions/*", "zone_name": "theexactmatch.com" },
		// Only the photo bytes — the /recentmatches and /recentmatches/:slug
		// pages themselves are rendered by the site worker (theexactmatch), which
		// calls the /api/public/recent-matches* endpoints above over a service
		// binding so nav/footer/CSS stay single-source-of-truth.
		{ "pattern": "theexactmatch.com/recent-matches/photos/*", "zone_name": "theexactmatch.com" }
	],
	"workers_dev": true,
	"r2_buckets": [
		{ "binding": "PHOTOS", "bucket_name": "theexactmatch-vehicle-photos" }
	],
	"queues": {
		"producers": [
			{ "queue": "tem-report-jobs", "binding": "JOB_QUEUE" }
		],
		"consumers": [
			{ "queue": "tem-report-jobs", "max_batch_size": 5, "max_batch_timeout": 5, "max_retries": 3, "max_concurrency": 1, "dead_letter_queue": "tem-report-jobs-dlq" },
			{ "queue": "tem-report-jobs-dlq", "max_batch_size": 5, "max_batch_timeout": 5 }
		]
	},
	"triggers": {
		"crons": ["0 6 * * *", "*/15 * * * *", "0 11 * * *", "0 13 * * *"]
	}
}
